/*
 * banime40 — ZMK shield overlay
 * Ported from QMK keyboard.json (sporewoh/banime40)
 *
 * Matrix: 4 rows x 10 cols, ortho_4x10, diode direction COL2ROW.
 *
 * Pin mapping QMK (AVR) -> ZMK pro_micro interconnect GPIO index
 * (index == Arduino digital pin number silk-printed on the board):
 *   rows: E6->7  D7->6  C6->5  D4->4
 *   cols: B4->8  B5->9  B6->10 B2->16 B3->14 B1->15 F7->18 F6->19 F5->20 F4->21
 *
 * Trackpad Azoteq TPS43 (IQS572, I2C addr 0x74) — dùng các chân còn trống:
 *   SDA -> 2 (P0.17)   SCL -> 3 (P0.20)   (&pro_micro_i2c = i2c0 của nice_nano_v2)
 *   RDY -> 1 (P0.06)   RST -> 0 (P0.08)
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        /* COL2ROW: rows are inputs (read), cols are outputs (driven) */
        row-gpios
            = <&pro_micro  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* E6 */
            , <&pro_micro  5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* D7 */
            , <&pro_micro  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* C6 */
            , <&pro_micro  7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* D4 */
            ;

        col-gpios
            = <&pro_micro  9 GPIO_ACTIVE_HIGH>  /* B4 */
            , <&pro_micro  8 GPIO_ACTIVE_HIGH>  /* B5 */
            , <&pro_micro 10 GPIO_ACTIVE_HIGH>  /* B6 */
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>  /* B2 */
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>  /* B3 */
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>  /* B1 */
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>  /* F7 */
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>  /* F6 */
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>  /* F5 */
            , <&pro_micro 21 GPIO_ACTIVE_HIGH>  /* F4 */
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        /* map[row][col] -> RC(row, col), matching LAYOUT_ortho_4x10 */
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };
};

&pro_micro_i2c {
    status = "okay";

    tps43: iqs5xx@74 {
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;
        status = "okay";

        rdy-gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&pro_micro 0 GPIO_ACTIVE_LOW>;

        /* Gesture: xem dts/bindings/input/azoteq,iqs5xx-common.yaml của driver */
        one-finger-tap;          /* chạm 1 ngón  = click trái */
        two-finger-tap;          /* chạm 2 ngón  = click phải */
        press-and-hold;          /* giữ          = kéo thả */
        press-and-hold-time = <250>;
        scroll;                  /* 2 ngón vuốt  = cuộn dọc/ngang */
        /*
         * Không đặt natural-scroll-x/y: mặc định của driver đã giống Windows
         * (nội dung đi theo ngón tay — vuốt xuống thì trang cuộn lên).
         * Thêm natural-scroll-y nếu muốn kiểu bánh xe chuột (vuốt xuống = cuộn xuống).
         */

        bottom-beta = <5>;
        stationary-threshold = <5>;

        /* Chỉnh hướng theo cách lắp trackpad: switch-xy; flip-x; flip-y; */
        switch-xy;               /* trục X/Y bị hoán đổi theo hướng lắp hiện tại */
    };
};

/ {
    tps43_listener: tps43_listener {
        compatible = "zmk,input-listener";
        device = <&tps43>;
    };
};
